# 把这个文件复制一份成 .env，填上自己的值
# .env 已经在 .gitignore 里，不会被传上去

# ---- MiniMax API（必填，LLM 走 MiniMax-M3 的 OpenAI 兼容接口）----
# 注册地址: https://platform.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com/v1

# ---- Neo4j（可选，不填也能跑，知识图谱会回落到内置内存图）----
# 用 docker-compose up -d 起的 Neo4j 默认就是下面这套
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ---- ragas 评估专用（可选）----
# ragas 跟主环境的 numpy 版本冲突，得单独建个虚拟环境跑。
# 这里填那个虚拟环境的 site-packages 路径，只有跑 17b_ragas_official.py 才用。
# 不填就不跑 ragas，不影响别的。
# RAGAS_ENV=
